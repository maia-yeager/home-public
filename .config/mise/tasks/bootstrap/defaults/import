#!/usr/bin/env zsh
#USAGE arg "<domains>..."
#USAGE complete "domains" run="/bin/zsh -c 'echo ${(F)${(as:, :)$(defaults domains)}}'"

# case-sensitive
local key_ignore_regexes=(
  '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'
  '^(CK|SK)[A-Z]'
  '^AppleTextDirection$'
  '^NS(FullScreen|NavPanelExpanded|OS|Treat|Window)'
  '^SU(HasLaunchedBefore|ScheduledCheckInterval|UpdateRelaunchingMarker)$'
)
local config_path=${XDG_CONFIG_HOME}/mise/conf.d/bootstrap/mise.macos.toml

local -a domains
eval "domains=($usage_domains)"
local json_data=$(mise run get:defaults ${domains})
local ignore_regex=\(${${(j:|:)key_ignore_regexes}}\)

json_data=${json_data} ignore_regex=${ignore_regex} yq -i '
("${ignore_regex}" | envsubst) as $ignore_regex
| ("${json_data}" | envsubst | from_json) as $new_data
| with(
  .bootstrap.macos.defaults;
  . ref $config_data
  | $new_data | with_entries(
    $config_data[.key] = $config_data[.key] *n (
      .value | with_entries(
        select(.key | test($ignore_regex) | not)
      )
    )
  )
  | $config_data | sort_keys(..)
)
' ${config_path}
