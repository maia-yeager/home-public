#!/usr/bin/env zsh
#USAGE arg "[domains]..."
#USAGE complete "domains" run="/bin/zsh -c 'echo ${(F)${(as:, :)$(defaults domains)}}'"

local config_path=${XDG_CONFIG_HOME}/mise/conf.d/bootstrap/mise.macos.toml

local -a domains
if [[ -n $usage_domains ]] {
  eval "domains=($usage_domains)"
} else {
  domains=($(yq -rojson '.bootstrap.macos.defaults | keys[]' ${config_path}))
}
if (( $#domains < 1 )) {
  >&2 echo "No domains provided or currently configured.
Consider using 'import' instead."
  exit 1
}

local json_data=$(mise run get:defaults ${domains})
json_data=${json_data} yq -i '
("${json_data}" | envsubst | from_json) as $new_data
| with(
  .bootstrap.macos.defaults;
  . = . *? $new_data | sort_keys(..)
)
' ${config_path}
